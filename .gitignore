# ---- 构建中间产物 ----
build/
*.class
*.dex
*.idsig

# ---- 签名密钥：绝不入库 ----
# build.ps1 在首次构建时若发现密钥不存在，会用 keytool 自动生成一个，
# 所以别人 clone 下来可以直接构建，不需要你交出私钥。
keystore/
*.jks
*.keystore
*.p12
*.pem.bak

# ---- 调试残渣 ----
tools/out_*.txt
tools/out_*.log

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.iml
Thumbs.db
Desktop.ini
.DS_Store

# ---- 本地临时 ----
*.tmp
*.bak
*.orig
